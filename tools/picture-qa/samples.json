{
  "version": 1,
  "_doc": "picture-qa regression set. Every frame is generated by synth.mjs from the scene below (no image files). Each failure mode a reviewer has seen in procedural night exteriors has a FAIL frame and a PASS frame. `node tools/picture-qa/picture-qa.mjs --selftest` must meet every expectation; anyone who changes a threshold or an algorithm must keep it green and add a sample for the new case.",
  "scenes": {
    "clean": {"seed": 3, "layers": [{"type": "disk", "cx": 0.8, "cy": 0.12, "r": 0.025}]},
    "stripedWall": {"base": "@clean", "addLayers": [{"type": "stripes", "rect": [0.05, 0.4, 0.6, 1], "period": 11, "angle": 90, "amp": 0.03}]},
    "radialStreaks": {"base": "@clean", "addLayers": [{"type": "stripes", "rect": [0.0, 0.4, 0.5, 1], "period": 9, "angle": 60, "amp": 0.03}, {"type": "stripes", "rect": [0.5, 0.4, 1, 1], "period": 9, "angle": 120, "amp": 0.03}]},
    "strataBands": {"base": "@clean", "addLayers": [{"type": "stripes", "rect": [0.0, 0.4, 0.3, 1], "period": 14, "angle": 0, "amp": 0.03}]},
    "weakStreaks": {"base": "@clean", "addLayers": [{"type": "stripes", "rect": [0.05, 0.4, 0.6, 1], "period": 11, "angle": 75, "amp": 0.0025}]},
    "groundTint": {"base": "@clean", "ground": {"color": [0.25, 0.27, 0.33]}},
    "whiteOutline": {"base": "@clean", "addLayers": [{"type": "figure", "cx": 0.5, "foot": 0.92, "height": 0.5, "halo": {"width": 3, "gain": 0.45}}]},
    "coldRimLine": {"base": "@clean", "addLayers": [{"type": "figure", "cx": 0.5, "foot": 0.92, "height": 0.5, "halo": {"width": 1, "gain": 0.05}}]},
    "brightEave": {"base": "@clean", "addLayers": [{"type": "tint", "rect": [0.1, 0.5, 0.9, 0.62], "color": [0.012, 0.014, 0.02], "k": 1}, {"type": "tint", "rect": [0.1, 0.493, 0.9, 0.5], "color": [0.62, 0.68, 0.78], "k": 1}]},
    "flatSlab": {"base": "@clean", "addLayers": [{"type": "flat", "rect": [0.1, 0.3, 0.45, 0.9], "color": [0.03, 0.03, 0.035]}]},
    "skyOnly": {"seed": 5, "sky": {"horizon": 1.0, "top": [0.02, 0.03, 0.07], "bottom": [0.12, 0.15, 0.24]}, "layers": [{"type": "disk", "cx": 0.7, "cy": 0.3, "r": 0.03}]},
    "greyFog": {"base": "@clean", "addLayers": [{"type": "fog", "level": 0.33, "k": 0.85}]},
    "cumulus": {"base": "@clean", "addLayers": [{"type": "blob", "cx": 0.3, "cy": 0.17, "rx": 0.07, "ry": 0.045, "amp": 0.07}, {"type": "blob", "cx": 0.62, "cy": 0.12, "rx": 0.09, "ry": 0.05, "amp": 0.06}]},
    "cirrusAndMoon": {"base": "@clean", "addLayers": [{"type": "streak", "cx": 0.45, "cy": 0.14, "len": 0.3, "thick": 0.012, "amp": 0.03, "angle": -4}]},
    "warmFlood": {"base": "@clean", "addLayers": [{"type": "tint", "rect": [0.55, 0.5, 0.85, 0.95], "color": [0.55, 0.28, 0.08], "k": 0.8}]},
    "oneWarmLamp": {"base": "@clean", "addLayers": [{"type": "blob", "cx": 0.6, "cy": 0.8, "rx": 0.02, "amp": 0.5, "color": [1, 0.5, 0.15]}]},
    "newGroundMaterial": {"base": "@clean", "seed": 4},
    "stripedWallSkyEdit": {"base": "@stripedWall", "addLayers": [{"type": "blob", "cx": 0.85, "cy": 0.18, "rx": 0.08, "amp": 0.04}]}
  },
  "samples": [
    {"id": "clean-night", "scene": "@clean", "expect": {"stripes": "PASS", "halo": "PASS", "flat": "PASS", "luma": "PASS", "clouds": "PASS", "warm": "PASS"}, "note": "reference: textured ground, gradient sky, small moon"},

    {"id": "striped-wall", "scene": "@stripedWall", "expect": {"stripes": "FAIL"}, "note": "vertical stripe wall (xz projection on a vertical face / UV stretch)"},
    {"id": "radial-streaks", "scene": "@radialStreaks", "expect": {"stripes": "FAIL"}, "note": "long anisotropic ground pattern converging into radial streaks"},
    {"id": "strata-bands", "scene": "@strataBands", "sky": "none", "expect": {"stripes": "FAIL"}, "note": "strong horizontal bands (strata / wavy planks) without a declaration"},
    {"id": "strata-declared", "scene": "@strataBands", "config": {"defaults": {"allowStripes": [{"rect": [0.0, 0.35, 0.32, 1.0], "why": "designed layered wall courses"}], "exempt": ["designed-texture"], "_why": "designed layered wall courses on the left"}}, "expect": {"stripes": "PASS"}, "note": "designed regular texture declared in allowStripes (with why) passes"},
    {"id": "weak-streaks-undetected", "scene": "@weakStreaks", "expect": {"stripes": "PASS"}, "note": "known limit: low-contrast streaks below amp 0.0035 are not seen by ①, so ⑥ + roi is the backstop"},

    {"id": "white-outline", "scene": "@whiteOutline", "expect": {"halo": "FAIL"}, "note": "3 px bright ring around a dark figure (matte/rim misregistered or too wide)"},
    {"id": "cold-rim-line", "scene": "@coldRimLine", "expect": {"halo": "PASS", "flat": "PASS"}, "note": "1 px low-gain cold rim on the same figure"},
    {"id": "bright-eave", "scene": "@brightEave", "only": ["halo"], "expect": {"halo": "PASS"}, "note": "straight bright eave over a dark band: one gradient direction, not a closed outline"},

    {"id": "flat-slab", "scene": "@flatSlab", "expect": {"flat": "FAIL"}, "note": "untextured dark polygon covering 15% of the frame"},
    {"id": "sky-only-auto", "scene": "@skyOnly", "only": ["flat"], "expect": {"flat": "FAIL"}, "note": "known false positive: upward pure-sky frame has no horizon, auto sky finds nothing"},
    {"id": "sky-only-declared", "scene": "@skyOnly", "config": {"defaults": {"sky": {"rects": [[0, 0, 1, 1]]}, "exempt": ["non-sky-region"], "_why": "upward framing: the whole frame is sky"}}, "only": ["flat", "clouds"], "expect": {"flat": "PASS", "clouds": "PASS"}, "note": "same frame with sky.rects in the shot config"},

    {"id": "grey-fog", "scene": "@greyFog", "expect": {"luma": "FAIL"}, "note": "whole-frame grey veil: p01 high, dynamic range 0.07"},
    {"id": "luma-band-too-dark", "scene": "@clean", "luma": {"lo": 0.3, "hi": 0.4}, "expect": {"luma": "FAIL"}, "note": "same clean frame against a brighter per-shot band"},

    {"id": "cumulus", "scene": "@cumulus", "expect": {"clouds": "FAIL"}, "note": "compact bright cloud blobs in a clear night sky"},
    {"id": "cirrus-and-moon", "scene": "@cirrusAndMoon", "expect": {"clouds": "PASS"}, "note": "thin cirrus streak and a moon disk are allowed"},

    {"id": "warm-flood", "scene": "@warmFlood", "warmMax": 0.05, "expect": {"warm": "FAIL"}, "note": "night frame with 13% warm pixels against a 5% budget"},
    {"id": "warm-flood-dawn", "scene": "@warmFlood", "warmMax": 0.5, "expect": {"warm": "PASS"}, "note": "same frame in a shot configured as warm dawn"},
    {"id": "one-warm-lamp", "scene": "@oneWarmLamp", "warmMax": 0.02, "expect": {"warm": "PASS"}, "note": "a single small warm lamp under a 2% budget"},

    {"id": "claim-fixed-changed", "scene": "@clean", "prev": "@stripedWall", "claim": ["stripes"], "expect": {"diff": "PASS", "stripes": "PASS"}, "note": "claimed stripes fix, problem region really changed"},
    {"id": "claim-fixed-unchanged", "scene": "@stripedWall", "prev": "@stripedWall", "claim": ["stripes"], "expect": {"diff": "FAIL"}, "note": "claimed fixed but the frame is identical"},
    {"id": "claim-edit-elsewhere", "scene": "@stripedWallSkyEdit", "prev": "@stripedWall", "claim": ["stripes"], "expect": {"diff": "FAIL"}, "note": "something changed, but not the claimed problem region"},
    {"id": "claim-unverifiable", "scene": "@clean", "prev": "@groundTint", "claim": ["halo"], "expect": {"diff": "FAIL"}, "note": "claim names a check the previous frame never failed and gives no roi"},
    {"id": "claim-roi-changed", "scene": "@newGroundMaterial", "prev": "@weakStreaks", "claim": ["stripes"], "roi": [0.05, 0.4, 0.6, 1.0], "expect": {"diff": "PASS"}, "note": "undetected low-contrast streaks: the roi carries the claim; the ground material was replaced, so the roi really changed"},
    {"id": "claim-roi-unchanged", "scene": "@weakStreaks", "prev": "@weakStreaks", "claim": ["stripes"], "roi": [0.05, 0.4, 0.6, 1.0], "expect": {"diff": "FAIL"}, "note": "same roi, frame unchanged"},
    {"id": "require-change-identical", "scene": "@clean", "prev": "@clean", "requireChange": 0.02, "expect": {"diff": "FAIL"}, "note": "a new version must differ from the previous one when --require-change is set"},
    {"id": "open-issue-not-claimed", "scene": "@stripedWall", "prev": "@stripedWall", "expect": {"diff": "PASS", "stripes": "FAIL"}, "note": "unclaimed old problem stays listed as open; ① still fails on its own"}
  ]
}
